   "source": [
    "%display latex\n",
    "a=var('a')\n",
    "f(x)=(-1/(4*pi))*(1/(x^2 + a^2)^(1/2))\n",
    "display(f)\n",
    "fp=derivative(f,x)\n",
    "display(fp)\n",
    "fpp=derivative(fp,x)\n",
    "display(fpp)\n"
   ]
